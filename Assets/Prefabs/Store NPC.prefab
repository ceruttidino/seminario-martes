  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d4278b4c79c2a944a9e6a81af31ce5d5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  fillerDialogue:
  - Hard Time Deciding?
  - Great choices, All of them
  - Have you seen those green crates? Good shinies inside of them
  - Any scrap is good scrap
  - Darn Moles, They like steraling me shines
  - You Strangers enjoy discrading useful stuff
  greetingDialogue:
  - Welcome Stranger
  - Back? So Soon?
  - I thought you had made it already
  - Finest wares in the forest
  purchaseDialogue:
  - A wise Choice
  - I see you are no fool
  - A... personal Favorite
  - Excelent Descidion
  - May it prove useful on your journey Stranger
  failedPurchaseDialogue:
  - Sorry stranger, i cant give credit, come back when you are richer
  - Sorry stranger, i dont give out free stuff
  - Yer pockets are too light for that stranger
  worriedDialogue:
  - Are you ok?
  - Im Scared
  - Please Stop doing that
  textPosition: {fileID: 1733623465307017650}
  textDurationPerWord: 0.5
  timeBetweenDialogues: 5
